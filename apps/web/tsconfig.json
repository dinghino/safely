{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["bun-types"],
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/form/*": ["../../packages/form/src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./.next/types/**/*.ts",
    "./next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["./node_modules", "**/*.stories.tsx", "**/*.stories.ts"]
}
