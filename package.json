{
  "name": "safely",
  "dependencies": {
    "nuqs": "^2.6.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6"
  },
  "packageManager": "bun@1.2.22",
  "private": true,
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @workspace/backend dev",
    "dev:setup": "turbo -F @workspace/backend dev:setup",
    "dev:bump": "bunx taze -r"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
