# Bounding box for map boundaries (required)
# Example: New York City area
BBOX_MIN_LAT=40.7
BBOX_MIN_LON=-74.1
BBOX_MAX_LAT=40.8
BBOX_MAX_LON=-73.9

# Convex configuration (optional - only needed for seeding to database)
# Get this from your Convex dashboard
CONVEX_URL=https://your-deployment.convex.cloud

# User ID to use as the author for imported POIs (temporary, for testing)
# You can use your own user ID from the platform
POI_AUTHOR_ID=your-clerk-user-id-here
