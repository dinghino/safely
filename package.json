{
  "name": "safely",
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "turbo": "^2.5.6"
  },
  "packageManager": "bun@1.2.22",
  "private": true,
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @safely/backend dev",
    "dev:setup": "turbo -F @safely/backend dev:setup"
  },
  "type": "module",
  "workspaces": ["apps/*", "packages/*"]
}
