{
  "name": "safely",
  "dependencies": {
    "nuqs": "^2.6.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@biomejs/biome": "^2.2.4",
    "turbo": "^2.5.6",
    "tsup": "^8.5.0"
  },
  "packageManager": "bun@1.2.22",
